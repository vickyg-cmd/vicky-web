---
import TermoTrendyPhone from "./apps/TermoTrendyPhone.astro";
import PassCatPhone from "./apps/PassCatPhone.astro";
import PkUpcPhone from "./apps/PkUpcPhone.astro";
import TodaSanaPhone from "./apps/TodaSanaPhone.astro";
import Flip from "./apps/Flip.astro";
import PkChart from "./apps/PkChart.astro";
import { translations, type Lang } from "../i18n/translations";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang];
const store = lang === "en" ? "us" : "es";
const links = {
  tt: `https://apps.apple.com/${store}/app/termotrendy/id6757545419`,
  pc: `https://apps.apple.com/${store}/app/passcat/id6753830043`,
  pcPlay: `https://play.google.com/store/apps/details?id=com.vickyg.pasaportcatala&hl=${lang}`,
};
// The picker only shows while the phones don't all fit side by side. To add an
// app: make a phone in apps/ (Phone.astro is the frame), add it to the picker
// and add a figure below with the same id.
const picker = [
  { id: "app-termotrendy", name: "TermoTrendy", icon: "/img/termotrendy-icon.webp" },
  { id: "app-passcat", name: "PassCat", icon: "/img/passcat-icon.webp" },
  { id: "app-pkupc", name: "PK UPC" },
  { id: "app-todasana", name: "TodaSana" },
];
---

<section class="apps section" id="apps" aria-labelledby="apps-title">
  <div class="wrap apps__intro">
    <h2 id="apps-title" set:html={t.apps_title} />
    <p>{t.apps_body}</p>
  </div>

  <div class="wrap">
    <div class="picker" role="group" aria-label={t.apps_pick}>
      {picker.map((p, i) => (
        <button type="button" data-target={p.id} aria-pressed={i === 0 ? "true" : "false"}>
          {p.icon ? <img src={p.icon} alt="" width="128" height="128" /> : <span class={`picker__dot picker__dot--${p.id}`} aria-hidden="true">{p.name[0]}</span>}
          {p.name}
        </button>
      ))}
    </div>
  </div>

  <div class="apps__row" data-row>
    <figure class="app" id="app-termotrendy">
      <div class="app__phone">
        <Flip lang={lang} color="#7BB1C7" ink="#1A1A1A">
          <TermoTrendyPhone lang={lang} />
          <ul slot="back">{t.tt_back.map((x) => <li>{x}</li>)}</ul>
        </Flip>
      </div>
      <figcaption>
        <p class="app__name"><img src="/img/termotrendy-icon.webp" alt="" width="128" height="128" /><span><b class="tt-a">termo</b><span class="tt-b">trendy</span></span></p>
        <p>{t.tt_line}</p>
        <ul class="chips">{t.tt_facts.map((f) => <li>{f}</li>)}</ul>
        <div class="app__acts"><a class="btn" href={links.tt}>{t.tt_cta}</a></div>
        <p class="app__hint">{t.tt_hint}</p>
      </figcaption>
    </figure>

    <figure class="app" id="app-passcat">
      <div class="app__phone">
        <Flip lang={lang} color="#440505" ink="#ECEDDC">
          <PassCatPhone />
          <ul slot="back">{t.pc_back.map((x) => <li>{x}</li>)}</ul>
        </Flip>
      </div>
      <figcaption>
        <p class="app__name"><img src="/img/passcat-icon.webp" alt="" width="128" height="128" /><span>PassCat</span></p>
        <p>{t.pc_line}</p>
        <ul class="chips">{t.pc_facts.map((f) => <li>{f}</li>)}</ul>
        <div class="app__acts">
          <a class="btn" href={links.pc}>{t.pc_cta}</a>
          <a class="btn btn--ghost" href={links.pcPlay}>{t.pc_play}</a>
        </div>
        <p class="app__hint">{t.pc_hint}</p>
      </figcaption>
    </figure>

    <figure class="app" id="app-pkupc">
      <div class="app__phone">
        <Flip lang={lang} color="#0E2A3A" ink="#FFFFFF">
          <PkUpcPhone lang={lang} />
          <Fragment slot="back">
            {t.pk_back.map((x) => <p>{x}</p>)}
            <PkChart lang={lang} />
            <ul>{t.pk_back_end.map((x) => <li>{x}</li>)}</ul>
          </Fragment>
        </Flip>
      </div>
      <figcaption>
        <p class="app__name"><span>PK UPC</span> <small>{t.pk_status}</small></p>
        <p>{t.pk_line}</p>
        <p class="app__hint">{t.pk_hint}</p>
      </figcaption>
    </figure>

    <figure class="app" id="app-todasana">
      <div class="app__phone">
        <Flip lang={lang} color="#1A3D3A" ink="#FFFFFF">
          <TodaSanaPhone />
          <ul slot="back">{t.ts_back.map((x) => <li>{x}</li>)}</ul>
        </Flip>
      </div>
      <figcaption>
        <p class="app__name"><span>TodaSana</span> <small>{t.ts_status}</small></p>
        <p>{t.ts_line}</p>
        <ul class="chips">{t.ts_facts.map((f) => <li>{f}</li>)}</ul>
        <p class="app__hint">{t.ts_hint}</p>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .apps {
    background: var(--muted);
    color: var(--paper);
  }
  .apps__intro {
    display: grid;
    gap: 0 clamp(2rem, 6vw, 5rem);
    align-items: end;
    margin-bottom: clamp(1.5rem, 4vw, 3rem);
  }
  .apps__intro p {
    max-width: 36ch;
    font-size: 1.2rem;
    color: var(--sun);
    font-weight: 700;
  }
  @media (min-width: 900px) {
    .apps__intro {
      grid-template-columns: minmax(0, 1fr) minmax(18rem, 26rem);
    }
    .apps__intro h2,
    .apps__intro p {
      margin-bottom: 0.4rem;
    }
  }
  h2 :global(em) {
    display: inline-block;
    padding: 0 0.12em;
    background: var(--sun);
    color: var(--ink);
    font-style: normal;
    rotate: -2deg;
  }

  /* ---- Narrow: one app at a time, swipe or pick ---- */
  .picker {
    display: flex;
    gap: 3px;
    width: fit-content;
    max-width: 100%;
    margin-bottom: 1.5rem;
    padding: 3px;
    border-radius: 14px;
    background: rgb(255 255 255 / 0.1);
  }
  .picker button {
    flex: 1 1 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 44px;
    padding: 0 0.75rem;
    border: 0;
    border-radius: 11px;
    background: transparent;
    color: var(--paper);
    font: 700 0.95rem var(--sans);
    white-space: nowrap;
    cursor: pointer;
  }
  .picker button[aria-pressed="true"] {
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 1px 4px rgb(26 26 26 / 0.18);
  }
  .picker img,
  .picker__dot {
    flex: none;
    width: 22px;
    height: 22px;
    border-radius: 6px;
  }
  .picker__dot {
    display: grid;
    place-items: center;
    background: #0E2A3A;
    color: #5BE1A0;
    font-size: 0.75rem;
    font-weight: 800;
  }
  .picker__dot--app-todasana {
    background: #1A3D3A;
    color: #F6D160;
  }
  @media (max-width: 420px) {
    .picker {
      width: 100%;
    }
    .picker button {
      padding: 0 0.4rem;
      font-size: 0.9rem;
    }
    .picker img,
    .picker__dot {
      display: none;
    }
  }

  .apps__row {
    position: relative;
    display: flex;
    gap: var(--gutter);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    padding: 0 var(--gutter) 0.5rem;
    scrollbar-width: none;
  }
  .apps__row::-webkit-scrollbar {
    display: none;
  }
  .app {
    flex: 0 0 100%;
    display: grid;
    gap: 1.5rem;
    align-content: start;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }
  .app__phone {
    justify-self: center;
  }
  /* Smallest phones: shrink the frame so it never runs past the screen. */
  @media (max-width: 340px) {
    .app__phone {
      zoom: 0.88;
    }
  }
  /* Tablets: phone and caption side by side. */
  @media (min-width: 640px) {
    .app {
      grid-template-columns: auto minmax(0, 1fr);
      gap: clamp(1.5rem, 5vw, 3.5rem);
      align-items: center;
    }
    figcaption {
      max-width: 34rem;
    }
  }

  /* ---- Wide: all three side by side, no picker ---- */
  @media (min-width: 1100px) {
    .picker {
      display: none;
    }
    .apps__row {
      justify-content: center;
      gap: clamp(2rem, 4vw, 4rem);
      overflow: visible;
      scroll-snap-type: none;
    }
    .app {
      flex: 0 0 314px;
      grid-template-columns: none;
      align-items: start;
    }
    .app:nth-child(2) {
      margin-top: 3rem;
    }
  }

  figcaption {
    display: grid;
    gap: 0.9rem;
    justify-items: start;
  }
  .app__name {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 800;
    font-size: 2rem;
    line-height: 1;
    letter-spacing: -0.03em;
    font-stretch: 75%;
  }
  .app__name img {
    width: 44px;
    height: 44px;
    border-radius: 10px;
  }
  /* TermoTrendy's own wordmark colors. */
  .tt-a {
    color: #C91F43;
  }
  .tt-b {
    color: #0B6A4C;
  }
  .app__name small {
    font: 700 0.9rem var(--sans);
    letter-spacing: 0;
    padding: 0.25rem 0.7rem;
    border: 2px solid var(--ink);
    border-radius: 999px;
  }
  .app__acts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .app__hint {
    font-size: 0.95rem;
    color: var(--butter);
  }

  /* Overrides for dark background */
  .apps :global(.flip__btn) {
    border-color: var(--paper);
    color: var(--paper);
  }
  .apps :global(.chips li) {
    background: var(--paper);
    color: var(--ink);
  }
  .apps :global(.btn) {
    background: var(--sun);
    color: var(--ink);
  }
  .apps :global(.btn--ghost) {
    background: transparent;
    border-color: var(--paper);
    color: var(--paper);
  }
  .app__name small {
    border-color: var(--butter);
    color: var(--butter);
  }
</style>

<script>
  const row = document.querySelector<HTMLElement>("[data-row]")!;
  const buttons = document.querySelectorAll<HTMLButtonElement>(".picker button");
  const smooth = () => (matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth");
  const select = (id: string) => buttons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.target === id)));

  // Picker → row.
  buttons.forEach((b) =>
    b.addEventListener("click", () => {
      const fig = document.getElementById(b.dataset.target!)!;
      row.scrollTo({ left: fig.offsetLeft - parseFloat(getComputedStyle(row).paddingLeft), behavior: smooth() });
      select(fig.id);
    }),
  );

  // Row → picker: whichever app is mostly on screen after a swipe.
  const io = new IntersectionObserver(
    (entries) => entries.forEach((e) => e.isIntersecting && select(e.target.id)),
    { root: row, threshold: 0.6 },
  );
  row.querySelectorAll(".app").forEach((fig) => io.observe(fig));
</script>

---
import BrowserFrame from "./webs/BrowserFrame.astro";
import OffkitWeb from "./webs/OffkitWeb.astro";
import { translations, type Lang } from "../i18n/translations";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang];
---

<section class="webs section" id="webs" aria-labelledby="webs-title">
  <div class="wrap webs__intro">
    <h2 id="webs-title" set:html={t.webs_title} />
    <p>{t.webs_body}</p>
  </div>

  <div class="wrap webs__grid">
    <div class="web">
      <BrowserFrame url="offkit.es">
        <OffkitWeb />
      </BrowserFrame>
      <div class="web__info">
        <p class="web__name"><img src="/img/offkit-icon.png" alt="" />offkit <span>es</span></p>
        <p>{t.offkit_line}</p>
        <ul class="chips">{t.offkit_facts.map((f) => <li>{f}</li>)}</ul>
        <div class="web__acts">
          <a class="btn" href="https://offkit.es" target="_blank" rel="noopener">{t.offkit_cta}</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .webs {
    background: var(--sun);
    color: var(--ink);
  }
  .webs__intro {
    display: grid;
    gap: 0 clamp(2rem, 6vw, 5rem);
    align-items: end;
    margin-bottom: clamp(1.5rem, 4vw, 3rem);
  }
  .webs__intro p {
    max-width: 36ch;
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--ink);
    opacity: 0.7;
  }
  @media (min-width: 900px) {
    .webs__intro {
      grid-template-columns: minmax(0, 1fr) minmax(18rem, 26rem);
    }
    .webs__intro h2,
    .webs__intro p {
      margin-bottom: 0.4rem;
    }
  }
  h2 :global(em) {
    display: inline-block;
    padding: 0 0.12em;
    background: var(--ink);
    color: var(--sun);
    font-style: normal;
    rotate: -2deg;
  }

  .webs__grid {
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 5vw, 4rem);
  }
  .web {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }
  @media (min-width: 640px) {
    .web {
      grid-template-columns: auto 1fr;
      gap: clamp(1.5rem, 5vw, 3.5rem);
    }
    .web__info {
      max-width: 34rem;
    }
  }

  .web__info {
    display: grid;
    gap: 0.9rem;
    justify-items: start;
  }
  .web__name {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 900;
    font-size: 2rem;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .web__name img {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    flex-shrink: 0;
  }
  .web__name span {
    display: inline-block;
    background: #C8463A;
    color: #F3EADB;
    font-size: 0.55em;
    font-weight: 700;
    padding: 0.1em 0.5em;
    border-radius: 999px;
    vertical-align: middle;
    margin-left: 0.2em;
    letter-spacing: 0.04em;
  }
  .web__acts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .webs :global(.chips li) {
    background: var(--ink);
    color: var(--sun);
  }
  .webs :global(.btn) {
    background: var(--ink);
    color: var(--sun);
  }
</style>

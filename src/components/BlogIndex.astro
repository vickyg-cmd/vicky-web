---
import Layout from "../layouts/Layout.astro";
import Nav from "./Nav.astro";
import { langPath, translations, type Lang } from "../i18n/translations";
import { SITE_NAME } from "../config";
import { blogLangs, formatDate, getPosts, postSlug } from "../lib/blog";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang];
const posts = await getPosts(lang);
const alternates = await blogLangs();
---

<Layout
  lang={lang}
  subpath="blog"
  alternates={alternates}
  title={`${t.blog_title} | ${SITE_NAME}`}
  description={t.blog_description}
>
  <Nav lang={lang} subpath="blog" alternates={alternates} />
  <main class="wrap section">
    <h1>{t.blog_title}</h1>
    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <a href={langPath(lang, `blog/${postSlug(post)}`)}>{post.data.title}</a>
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, lang)}</time>
          <p>{post.data.description}</p>
        </li>
      ))}
    </ul>
  </main>
</Layout>

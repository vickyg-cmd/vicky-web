---
import Layout from "../layouts/Layout.astro";
import Nav from "./Nav.astro";
import Hero from "./Hero.astro";
import Apps from "./Apps.astro";
import Ticker from "./Ticker.astro";
import Now from "./Now.astro";
import Timeline from "./Timeline.astro";
import OffScreen from "./OffScreen.astro";
import Contact from "./Contact.astro";
import Schema from "./Schema.astro";
import { type Lang } from "../i18n/translations";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<Layout lang={lang}>
  <Schema lang={lang} slot="head" />
  <Nav lang={lang} />
  <Hero lang={lang} />
  <main>
    <Apps lang={lang} />
    <Ticker lang={lang} />
    <Now lang={lang} />
    <Timeline lang={lang} />
    <OffScreen lang={lang} />
  </main>
  <Contact lang={lang} />
</Layout>

---
/** Recreated preview of offkitbcn.com's hero. */
---

<div class="ok">
  <div class="ok__banner">PREVENTA 17 NOV &nbsp;·&nbsp; SOLO 10 CAJAS &nbsp;·&nbsp; ENVÍO GRATIS</div>
  <nav class="ok__nav">
    <span class="ok__logo">
      <svg class="ok__switch" viewBox="0 0 51 32" width="34" height="21" aria-hidden="true">
        <rect x="3" y="3" width="45" height="26" rx="13" stroke="currentColor" stroke-width="6" fill="none"/>
        <circle cx="16" cy="16" r="7" fill="#E3A24E"/>
      </svg>
      <span class="ok__wordmark">ffkit</span>
      <span class="ok__tag">bcn</span>
    </span>
    <span class="ok__cta">Apúntate</span>
  </nav>
  <div class="ok__hero">
    <p class="ok__pre">kits analógicos</p>
    <h2 class="ok__h">para desconectar<br/>del móvil.</h2>
    <div class="ok__stripes">
      <span style="background:#C8463A"></span>
      <span style="background:#E8683E"></span>
      <span style="background:#E3A24E"></span>
      <span style="background:#4A8592"></span>
    </div>
  </div>
</div>

<style>
  .ok {
    background: #121212;
    color: #F3EADB;
    height: 100%;
    display: flex;
    flex-direction: column;
    font-family: system-ui, sans-serif;
  }
  .ok__banner {
    background: #C8463A;
    color: #F3EADB;
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-align: center;
    padding: 0.3rem 0.5rem;
    white-space: nowrap;
    overflow: hidden;
  }
  .ok__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.6rem 1rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
  }
  .ok__logo {
    display: flex;
    align-items: center;
    gap: 1px;
  }
  .ok__switch {
    color: #F3EADB;
  }
  .ok__wordmark {
    font-size: 1rem;
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .ok__tag {
    font-size: 0.45rem;
    font-weight: 700;
    background: #E3A24E;
    color: #121212;
    padding: 0.1em 0.4em;
    border-radius: 999px;
    align-self: flex-start;
    margin-left: 3px;
    margin-top: -4px;
    letter-spacing: 0.04em;
  }
  .ok__cta {
    font-size: 0.6rem;
    font-weight: 700;
    background: #E3A24E;
    color: #121212;
    padding: 0.35em 0.8em;
    border-radius: 999px;
  }
  .ok__hero {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 1rem 1.2rem 0.8rem;
    gap: 0.4rem;
  }
  .ok__pre {
    font-size: 0.65rem;
    font-weight: 600;
    color: #E3A24E;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .ok__h {
    font-size: 1.45rem;
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }
  .ok__stripes {
    display: flex;
    gap: 4px;
    margin-top: 0.6rem;
  }
  .ok__stripes span {
    height: 8px;
    flex: 1;
    border-radius: 4px;
  }
</style>

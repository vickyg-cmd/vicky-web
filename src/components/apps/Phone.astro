---
/** An iPhone frame, made in HTML and CSS. Screens go in the slot as `.view`
 *  elements; see TermoTrendyPhone.astro for a navigation stack. */
interface Props {
  time: string;
  /** The status bar text color, to suit the app's top screen. */
  statusColor?: string;
  id?: string;
}

const { time, statusColor = "#fff", id } = Astro.props;
---

<div class="device">
  <div class="screen" id={id}>
    <div class="island"></div>
    <div class="status" style={`color: ${statusColor}`} aria-hidden="true"><span>{time}</span><span>5G</span></div>
    <slot />
  </div>
</div>

<style>
  .device {
    width: 292px;
    height: 620px;
    padding: 11px;
    border-radius: 48px;
    background: var(--ink);
    box-shadow: 0 30px 50px -20px rgb(17 16 20 / 0.55);
  }
  .screen {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 38px;
    overflow: hidden;
    font-family: var(--app);
  }
  .status {
    position: absolute;
    z-index: 3;
    inset: 0 0 auto;
    height: 44px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 26px;
    font: 700 14px var(--app);
    pointer-events: none;
  }
  .island {
    position: absolute;
    z-index: 4;
    top: 10px;
    left: 50%;
    translate: -50% 0;
    width: 92px;
    height: 26px;
    border-radius: 20px;
    background: var(--ink);
  }

  /* Screens inside the slot. */
  .screen :global(.view) {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    padding: 56px 18px 18px;
    transition:
      transform calc(0.32s / var(--speed)) cubic-bezier(0.3, 0.8, 0.2, 1),
      opacity calc(0.32s / var(--speed));
  }
  .screen :global(.view[data-pos="right"]) {
    transform: translateX(100%);
  }
  .screen :global(.view[data-pos="left"]) {
    transform: translateX(-30%);
    opacity: 0.4;
  }
  @media (prefers-reduced-motion: reduce) {
    .screen :global(.view) {
      transition: none;
    }
  }
  /* A label on the screens recreated for this page, so nobody takes them for the real app. */
  .screen :global(.note) {
    margin-top: auto;
    padding: 6px;
    border-radius: 10px;
    background: rgb(255 255 255 / 0.55);
    font: 700 11px var(--app);
    text-align: center;
  }
</style>

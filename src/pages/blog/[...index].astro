---
import BlogIndex from "../../components/BlogIndex.astro";
import { ROOT_LANG } from "../../i18n/translations";
import { getPosts } from "../../lib/blog";

// /blog/ for the root language. A rest param that is always undefined, so the
// page is only built once there are posts: a site without a blog gets no
// empty /blog/ page in its sitemap.
export async function getStaticPaths() {
  return (await getPosts(ROOT_LANG)).length ? [{ params: { index: undefined } }] : [];
}
---

<BlogIndex lang={ROOT_LANG} />

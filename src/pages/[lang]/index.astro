---
import HomePage from "../../components/HomePage.astro";
import { langs, ROOT_LANG, type Lang } from "../../i18n/translations";

// Spanish is served at "/", English at /en/ and Catalan at /ca/.
export function getStaticPaths() {
  return langs.filter((l) => l !== ROOT_LANG).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---

<HomePage lang={lang} />

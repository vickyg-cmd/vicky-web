---
import HomePage from "../../components/HomePage.astro";
import { langs, ROOT_LANG, type Lang } from "../../i18n/translations";

// The root language is served at "/"; the other two get /gl/, /en/ and so on.
export function getStaticPaths() {
  return langs.filter((l) => l !== ROOT_LANG).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---

<HomePage lang={lang} />

---
import BlogIndex from "../../../components/BlogIndex.astro";
import { ROOT_LANG, type Lang } from "../../../i18n/translations";
import { blogLangs } from "../../../lib/blog";

// /<lang>/blog/ for the other two languages, only for those with posts.
export async function getStaticPaths() {
  return (await blogLangs()).filter((l) => l !== ROOT_LANG).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---

<BlogIndex lang={lang} />
